{
  "$schema": "http://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Galvy \u2014 OPNsense 26.7 / FreeBSD 15.1",
      "steps": [
        {
          "name": "OPNSenseScenario",
          "label": "Deployment Scenarios",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "subscription": {
                "constraints": {
                  "validations": []
                },
                "resourceProviders": [
                  "Microsoft.Compute"
                ]
              },
              "location": {
                "label": "Region",
                "toolTip": "Azure region",
                "resourceTypes": [
                  "Microsoft.Compute/virtualMachines"
                ],
                "allowedValues": []
              }
            },
            {
              "name": "scenarioOption",
              "type": "Microsoft.Common.DropDown",
              "label": "OPNSense Scenario",
              "placeholder": "",
              "defaultValue": "TwoNics",
              "toolTip": "Choose a single firewall or two active-active firewalls.",
              "multiselect": false,
              "selectAll": false,
              "filter": false,
              "filterPlaceholder": "",
              "multiLine": true,
              "defaultDescription": "Choose a single firewall or two active-active firewalls.",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "TwoNics",
                    "description": "Single OPNSense Deployment with 2 Nics in a Trusted and Untrusted Subnets.",
                    "value": "TwoNics"
                  },
                  {
                    "label": "Active-Active",
                    "value": "Active-Active",
                    "description": "Two OPNsense nodes behind public and internal Azure Standard load balancers."
                  }
                ],
                "required": true
              },
              "visible": true
            }
          ]
        },
        {
          "name": "VirtualMachineConfig",
          "label": "Virtual Machine Settings",
          "elements": [
            {
              "name": "vmName",
              "type": "Microsoft.Common.TextBox",
              "label": "Virtual Machine name",
              "toolTip": "VM name; active-active appends -Primary and -Secondary.",
              "defaultValue": "OPNsense",
              "constraints": {
                "required": true,
                "validations": []
              }
            },
            {
              "name": "vmSize",
              "type": "Microsoft.Compute.SizeSelector",
              "label": "Virtual machine size",
              "toolTip": "The size of virtual machine to provision.",
              "recommendedSizes": [
                "Standard_B2s"
              ],
              "constraints": {
                "allowedSizes": []
              },
              "osPlatform": "Linux",
              "count": "[if(equals(steps('OPNSenseScenario').scenarioOption,'Active-Active'),2,1)]",
              "scope": {
                "subscriptionId": "[steps('OPNSenseScenario').resourceScope.subscription.subscriptionId]",
                "location": "[steps('OPNSenseScenario').resourceScope.location.name]"
              }
            },
            {
              "name": "managementSourceCIDR",
              "type": "Microsoft.Common.TextBox",
              "label": "Your public IPv4 address/CIDR for management",
              "toolTip": "For example 203.0.113.10/32. SSH and HTTPS are restricted to this source in Azure NSG.",
              "constraints": {
                "required": true,
                "regex": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$",
                "validationMessage": "Enter an IPv4 CIDR, for example 203.0.113.10/32."
              }
            },
            {
              "name": "FreeBSDImageVersion",
              "type": "Microsoft.Common.TextBox",
              "label": "FreeBSD 15.1 image revision",
              "defaultValue": "latest",
              "toolTip": "Use latest for the first test; use its resolved numeric revision to repeat with the same image.",
              "constraints": {
                "required": true,
                "regex": "^(latest|[0-9]+\\.[0-9]+\\.[0-9]+)$",
                "validationMessage": "Use latest or a numeric Marketplace image revision."
              }
            },
            {
              "name": "OpnScriptURI",
              "type": "Microsoft.Common.TextBox",
              "label": "OPNsense scripts URL",
              "toolTip": "All scripts must be under this URL path, check the expected content under scripts folder in https://github.com/Galvy/opnazure/tree/update/freebsd15-opnsense26.7/scripts.",
              "defaultValue": "https://raw.githubusercontent.com/Galvy/opnazure/update/freebsd15-opnsense26.7/scripts/",
              "constraints": {
                "required": true,
                "regex": "^https://[A-Za-z0-9._~:/%+-]+/$",
                "validationMessage": "Use an HTTPS directory URL ending in /."
              }
            },
            {
              "name": "ShellScriptName",
              "type": "Microsoft.Common.TextBox",
              "label": "Bootstrap script name to deploy OPNSense",
              "toolTip": "The script must be under the previous URL path. Reference: https://github.com/Galvy/opnazure/blob/update/freebsd15-opnsense26.7/scripts/configureopnsense.sh",
              "defaultValue": "configureopnsense.sh",
              "constraints": {
                "required": true,
                "regex": "^configureopnsense\\.sh$",
                "validationMessage": "Use configureopnsense.sh on this branch."
              }
            },
            {
              "name": "OpnVersion",
              "type": "Microsoft.Common.TextBox",
              "label": "OPNSense Version to deploy",
              "toolTip": "Install the latest available maintenance release in the 26.7 series.",
              "defaultValue": "26.7",
              "constraints": {
                "required": true,
                "regex": "^26\\.7$",
                "validationMessage": "This branch supports 26.7 only."
              }
            },
            {
              "name": "WALinuxVersion",
              "type": "Microsoft.Common.TextBox",
              "label": "Minimum Azure agent package version",
              "toolTip": "Install azure-agent from OPNsense, at least this version.",
              "defaultValue": "2.15.0.1"
            },
            {
              "name": "DeployWindows",
              "type": "Microsoft.Common.CheckBox",
              "label": "Deploy Windows Management VM in a Management Subnet.",
              "constraints": {}
            },
            {
              "name": "WinUsername",
              "type": "Microsoft.Compute.UserNameTextBox",
              "label": "Username",
              "toolTip": "Admin username for the machine",
              "osPlatform": "Windows",
              "constraints": {
                "required": true
              },
              "visible": "[if(steps('VirtualMachineConfig').DeployWindows,true,false)]"
            },
            {
              "name": "WinPassword",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "Password",
                "confirmPassword": "Confirm password"
              },
              "toolTip": "Admin password for the virtual machine",
              "constraints": {
                "required": true,
                "regex": "^(?=.*[A-Z])(?=.*[.!@#$%^&*()-_=+])(?=.*[0-9])(?=.*[a-z]).{12,40}$",
                "validationMessage": "Password must be at least 12 characters long, and contain upper case, lower case, number and symbol"
              },
              "options": {
                "hideConfirmation": false
              },
              "visible": "[if(steps('VirtualMachineConfig').DeployWindows,true,false)]"
            }
          ]
        },
        {
          "name": "VirtualNetworkConfig",
          "label": "Virtual Network Settings",
          "elements": [
            {
              "name": "vnetTwoNicsWindows",
              "type": "Microsoft.Network.VirtualNetworkCombo",
              "label": {
                "virtualNetwork": "Select an Existing VNet.",
                "subnets": "Select an existing subnet"
              },
              "toolTip": {
                "virtualNetwork": "Create a new VNet or select an existing VNet in the deployment resource group.",
                "subnets": "Must select an existing subnet"
              },
              "defaultValue": {
                "name": "OPN-VNET",
                "addressPrefixSize": "/16"
              },
              "constraints": {
                "minAddressPrefixSize": "/24"
              },
              "options": {
                "hideExisting": false
              },
              "subnets": {
                "Untrusted-Subnet": {
                  "label": "Untrusted-Subnet",
                  "defaultValue": {
                    "name": "Untrusted-Subnet",
                    "addressPrefixSize": "/24"
                  },
                  "constraints": {
                    "minAddressPrefixSize": "/28"
                  }
                },
                "Trusted-Subnet": {
                  "label": "Trusted-Subnet",
                  "defaultValue": {
                    "name": "Trusted-Subnet",
                    "addressPrefixSize": "/24"
                  },
                  "constraints": {
                    "minAddressPrefixSize": "/28"
                  }
                },
                "Windows-Subnet": {
                  "label": "Windows-Subnet",
                  "defaultValue": {
                    "name": "Windows-Subnet",
                    "addressPrefixSize": "/24"
                  },
                  "constraints": {
                    "minAddressPrefixSize": "/28"
                  }
                }
              },
              "visible": "[steps('VirtualMachineConfig').DeployWindows]"
            },
            {
              "name": "vnetTwoNicsnoWindows",
              "type": "Microsoft.Network.VirtualNetworkCombo",
              "label": {
                "virtualNetwork": "Select an Existing VNet.",
                "subnets": "Select an existing subnet"
              },
              "toolTip": {
                "virtualNetwork": "Create a new VNet or select an existing VNet in the deployment resource group.",
                "subnets": "Must select an existing subnet"
              },
              "defaultValue": {
                "name": "OPN-VNET",
                "addressPrefixSize": "/16"
              },
              "constraints": {
                "minAddressPrefixSize": "/24"
              },
              "options": {
                "hideExisting": false
              },
              "subnets": {
                "Untrusted-Subnet": {
                  "label": "Untrusted-Subnet",
                  "defaultValue": {
                    "name": "Untrusted-Subnet",
                    "addressPrefixSize": "/24"
                  },
                  "constraints": {
                    "minAddressPrefixSize": "/28"
                  }
                },
                "Trusted-Subnet": {
                  "label": "Trusted-Subnet",
                  "defaultValue": {
                    "name": "Trusted-Subnet",
                    "addressPrefixSize": "/24"
                  },
                  "constraints": {
                    "minAddressPrefixSize": "/28"
                  }
                }
              },
              "visible": "[not(steps('VirtualMachineConfig').DeployWindows)]"
            }
          ]
        }
      ]
    },
    "outputs": {
      "parameters": {
        "location": "[steps('OPNSenseScenario').resourceScope.location.name]",
        "scenarioOption": "[steps('OPNSenseScenario').scenarioOption]",
        "virtualMachineSize": "[steps('VirtualMachineConfig').vmSize]",
        "virtualMachineName": "[steps('VirtualMachineConfig').vmName]",
        "existingvirtualNetwork": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.newOrExisting,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.newOrExisting)]",
        "VNETAddress": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.addressPrefixes,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.addressPrefixes)]",
        "UntrustedSubnetCIDR": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.subnets.Untrusted-Subnet.addressPrefix,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.subnets.Untrusted-Subnet.addressPrefix)]",
        "TrustedSubnetCIDR": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.subnets.Trusted-Subnet.addressPrefix,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.subnets.Trusted-Subnet.addressPrefix)]",
        "existingUntrustedSubnetName": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.subnets.Untrusted-Subnet.name,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.subnets.Untrusted-Subnet.name)]",
        "existingTrustedSubnetName": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.subnets.Trusted-Subnet.name,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.subnets.Trusted-Subnet.name)]",
        "OpnScriptURI": "[steps('VirtualMachineConfig').OpnScriptURI]",
        "ShellScriptName": "[steps('VirtualMachineConfig').ShellScriptName]",
        "OpnVersion": "[steps('VirtualMachineConfig').OpnVersion]",
        "WALinuxVersion": "[steps('VirtualMachineConfig').WALinuxVersion]",
        "DeployWindows": "[steps('VirtualMachineConfig').DeployWindows]",
        "WinUsername": "[steps('VirtualMachineConfig').WinUsername]",
        "WinPassword": "[steps('VirtualMachineConfig').WinPassword]",
        "existingWindowsSubnet": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.subnets.Windows-Subnet.name,'')]",
        "DeployWindowsSubnet": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.subnets.Windows-Subnet.addressPrefix,'10.0.2.0/24')]",
        "Location": "[steps('OPNSenseScenario').resourceScope.location.name]",
        "virtualNetworkName": "[if(steps('VirtualMachineConfig').DeployWindows,steps('VirtualNetworkConfig').vnetTwoNicsWindows.name,steps('VirtualNetworkConfig').vnetTwoNicsnoWindows.name)]",
        "managementSourceCIDR": "[steps('VirtualMachineConfig').managementSourceCIDR]",
        "FreeBSDImageVersion": "[steps('VirtualMachineConfig').FreeBSDImageVersion]"
      },
      "kind": "ResourceGroup",
      "location": "[steps('OPNSenseScenario').resourceScope.location.name]",
      "resourceGroupId": "[steps('OPNSenseScenario').resourceScope.resourceGroup.id]"
    }
  }
}
